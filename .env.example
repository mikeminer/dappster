# AI providers
XAI_API_KEY=
XAI_GENERATION_MODEL=grok-4.20-0309-non-reasoning
XAI_GENERATION_FALLBACK_MODEL=grok-4.3
XAI_REQUEST_TIMEOUT_MS=240000
XAI_RETRY_BASE_DELAY_MS=750
ANTHROPIC_API_KEY=

# IPFS
PINATA_JWT=
# The dedicated public gateway shown in Pinata, for example example.mypinata.cloud.
PINATA_GATEWAY=

# Base RPC (optional; use a dedicated production endpoint when deployed)
BASE_RPC_URL=https://mainnet.base.org
NEXT_PUBLIC_BASE_MEMBERSHIP_CONTRACT=0xea7e37d45b6f75ae6826c1925d7b0ac314c7ecae

# Server-only relayers used exclusively to burn consumed credits.
# Never expose these values through NEXT_PUBLIC_* variables.
BASE_CREDIT_CONSUMER_PRIVATE_KEY=
SOLANA_CREDIT_CONSUMER_KEYPAIR=
# Dedicated sponsored Solana deployer. JSON byte array or base58 secret key.
# If omitted, SOLANA_CREDIT_CONSUMER_KEYPAIR is used as a backwards-compatible fallback.
SOLANA_DEPLOYER_KEYPAIR=

# App
NEXT_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_REOWN_PROJECT_ID=
# Move compiler snapshots are immutable Vercel Sandbox snapshots containing
# the pinned official Sui and Aptos CLI binaries. Enable each public deployment
# button only after its snapshot has passed testnet QA.
SUI_COMPILER_SNAPSHOT_ID=
APTOS_COMPILER_SNAPSHOT_ID=
NEXT_PUBLIC_SUI_DEPLOYMENT_ENABLED=false
NEXT_PUBLIC_APTOS_DEPLOYMENT_ENABLED=false
NEXT_PUBLIC_SUI_TESTNET_GRPC_URL=https://fullnode.testnet.sui.io:443
